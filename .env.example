# Local development only. Copy to .env and replace every placeholder.
NODE_ENV=development
APP_TIMEZONE=America/Fortaleza
POSTGRES_DB=missa_sync
POSTGRES_USER=missa_sync
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://missa_sync:replace-with-a-local-secret@localhost:5432/missa_sync?schema=public
REDIS_URL=redis://localhost:6379
PRIVATE_PACKAGE_STORAGE_DIR=storage/private/packages
PRIVATE_AUDIT_STORAGE_DIR=storage/private/audit
PRIVATE_RAW_SNAPSHOT_DIR=storage/private/raw-snapshots
PRIVATE_IMPORT_DIRECTORY=data/private/imports
API_PORT=3001
VITE_API_BASE_URL=
INTERNAL_INGEST_TOKEN=replace-with-a-private-random-token
DEVELOPMENT_PRIVATE_API_TOKEN=replace-with-a-local-development-token
LOCAL_AUTH_PASSWORD_SALT=replace-with-a-random-salt
LOCAL_AUTH_PASSWORD_HASH=replace-with-a-scrypt-hash
LOCAL_AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# Production only: containers are reachable through the host Nginx via loopback.
WEB_PORT=9020
API_PORT=9021
